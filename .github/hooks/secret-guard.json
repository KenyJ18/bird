{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Read",
        "bash": ".claude/hooks/copilot-read-secret-guard.sh",
        "cwd": ".",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "matcher": "Bash",
        "bash": ".claude/hooks/copilot-secret-guard.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
