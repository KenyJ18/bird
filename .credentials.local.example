# Bird Project - 実際の認証情報（テンプレート）
# このファイルは .gitignore に含まれていません（テンプレートとして公開）
# 実際の値は .credentials.local に保存してください（.gitignore 済み）

## ConoHa WING アカウント
CONOHA_EMAIL=<YOUR_EMAIL>
CONOHA_PASSWORD=<YOUR_PASSWORD>

## サーバー情報
SERVER_IP=<SERVER_IP>
SERVER_HOSTNAME=<SERVER_HOSTNAME>
SSH_HOST=<SSH_HOST>
SSH_PORT=8022
SSH_USER=<SSH_USER>
SSH_KEY_PATH=<YOUR_SSH_KEY_PATH>

## データベース情報
DB_HOST=<DB_HOST>
DB_PORT=3306
DB_NAME=<PREFIX>_bird_db
DB_USER=<PREFIX>_bird_user
DB_PASSWORD=<DB_PASSWORD>

## ドメイン
DOMAIN=<YOUR_DOMAIN>.conohawing.com

## SSH 接続コマンド例
# ssh -i ${SSH_KEY_PATH} -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST}

## MySQL 接続コマンド例
# mysql -h ${DB_HOST} -u ${DB_USER} -p${DB_PASSWORD} ${DB_NAME}
